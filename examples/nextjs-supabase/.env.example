# Copy to .env.local. Never commit real values.
STRIPE_SECRET_KEY=sk_test_replace_me
# "false" for a sandbox or test mode, "true" for live mode. Must match the key above.
STRIPE_LIVEMODE=false
# From the Stripe Dashboard endpoint, or printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me
SUPABASE_URL=https://your-project-ref.supabase.co
# A key that acts as the service_role. Server only: it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=replace_me
